// Gateway architecture of fsm_node.py, this project's finite state controller.
// Render: dot -Tpng -Gdpi=200 fsm_node.dot -o figures/fsm_node.png
digraph FSMNode {
    graph [rankdir=LR, fontname="DejaVu Sans", bgcolor="white", pad=0.35,
           nodesep=0.5, ranksep=0.85, splines=spline];
    node  [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled",
           penwidth=1.6, margin="0.2,0.14"];
    edge  [fontname="DejaVu Sans", fontsize=10, color="#4B5563", fontcolor="#1F2937",
           penwidth=1.4, arrowsize=0.85];

    wf    [label="wall_follower.py",       fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
    ca    [label="collision_avoidance.py", fillcolor="#FEE2E2", color="#DC2626", fontcolor="#7F1D1D"];
    ts    [label="teleop_scan.py",         fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A"];
    ds    [label="drive_square.py\n(restarts its square on\nentering DRIVE SQUARE via\ncurrent_mode, fixed 2026-09-22)",
           fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A"];
    pf    [label="path_following.py\n(shows/hides its own GUI\nvia current_mode, added\n2026-09-22)", fillcolor="#EDE9FE", color="#7C3AED", fontcolor="#4C1D95"];
    kb    [label="keyboard\n't' start scan, 'm' after\nscanning, 'g' wall-follow, 'p' path", shape=oval, fillcolor="#FEF3C7", color="#D97706"];
    fsm_cmd [label="/fsm_command\n(same t/m/g/p switches,\nadded 2026-09-22)", shape=oval, fillcolor="#F3F4F6", color="#6B7280"];

    subgraph cluster_gw {
        label="fsm_node.py -- publishes cmd_vel, subscribes to the rest"; labeljust=l;
        fontsize=11; fontcolor="#6B7280"; style="rounded,dashed"; color="#9CA3AF"; margin=18;
        state [label="self.state\n'WALL FOLLOW' | 'OBSTACLE AVOIDANCE' |\n'TELEOP SCAN' | 'DRIVE SQUARE' | 'PATH FOLLOWING'",
               shape=box, style="rounded,filled", fillcolor="#F3F4F6", color="#6B7280", fontcolor="#1F2937"];
        mode_pub [label="mode_pub: publishes\nself.state on current_mode\n(added 2026-09-22)", fillcolor="#F3F4F6", color="#6B7280", fontcolor="#1F2937"];
        mux   [label="forward whichever\ncmd_vel_* matches\nself.state", fillcolor="#EDE9FE", color="#7C3AED", fontcolor="#4C1D95"];
    }

    robot [label="Neato", shape=oval, fillcolor="#F3F4F6", color="#6B7280"];
    scan  [label="/scan", shape=oval, fillcolor="#F3F4F6", color="#6B7280"];
    bump  [label="/bump", shape=oval, fillcolor="#F3F4F6", color="#6B7280"];

    wf -> mux [label="cmd_vel_wall_follower"];
    ca -> mux [label="cmd_vel_collision_avoidance"];
    ts -> mux [label="cmd_vel_teleop_scan"];
    ds -> mux [label="cmd_vel_drive_square"];
    pf -> mux [label="cmd_vel_path_following"];
    mux -> robot [label="cmd_vel"];
    state -> mode_pub [style=dashed];
    mode_pub -> pf [label="current_mode", style=dashed, color="#7C3AED", fontcolor="#5B21B6"];
    mode_pub -> ds [label="current_mode -- restart on\nentering DRIVE SQUARE\n(fixed 2026-09-22)",
                    style=dashed, color="#2563EB", fontcolor="#1E3A8A"];

    scan -> state [label="front reading:\n<0.5m enters OBSTACLE AVOIDANCE\n>0.7m and not stuck returns to WALL FOLLOW\n(also enters after 3s spent under 1.0m --\nfixed 2026-09-22, see stuck note below)"];
    bump -> state [label="msg -> self.bumped = True (latched;\nsimulator sends no \"cleared\" message) --\nforces/holds OBSTACLE AVOIDANCE until\ncleared by check_bump_timeout()\n(ported 2026-09-22, see bump note below)"];
    kb -> state [style=dashed, label="only works with a real\nterminal (crash fixed\n2026-09-22, see note below)"];
    fsm_cmd -> state [style=dashed, color="#16A34A", fontcolor="#14532D",
                       label="works regardless of who\nowns stdin (added 2026-09-22)"];
    stuck [shape=note, style=filled, fillcolor="#FEF3C7", color="#D97706", fontcolor="#92400E", fontsize=10,
           label="fixed 2026-09-22: wall_follower turns\naway on its own at 1.0m, which kept\nfront just above the 0.5m switch\nforever -- state stayed WALL FOLLOW\n224/224 scans in a 45s test. Added a\n3s stuck timeout, independent of state,\nthat forces the switch anyway. Verified\nlive: 90s run, 6 clean transitions,\n7.5m travelled, 0 bumps, robot visibly\nescapes corners instead of spinning."];
    stuck -> state [style=dotted, color="#D97706", arrowhead=none];
    state -> mux [style=dashed];

    note [shape=note, style=filled, fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=10,
          label="fixed 2026-09-22: launch/fsm.launch.py is now\ninstalled (setup.py's data_files) and names\nros_behaviors_fsm for all three nodes.\nros2 launch ros_behaviors_fsm bringup.launch.py\nalso starts Gazebo first. Verified live: both\nlaunch and bring up every node with no errors\n(besides the keyboard-listener limitation,\nwhich is a stdin limitation, not a launch bug)."];
    bump_note [shape=note, style=filled, fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=10,
          label="fixed 2026-09-22: fsm_node.py had no bump\nsubscription at all. Added process_bump(), which\nonly ever latches self.bumped True (the simulator\nsends no \"cleared\" message); check_bump_timeout(),\ncalled every scan, clears it after 0.3s with no\nnew bump. Verified against the real class (bump\nforces and holds OBSTACLE AVOIDANCE, clears on\ntimeout); not yet confirmed with a real bump live."];
    bump_note -> state [style=dotted, color="#16A34A", arrowhead=none];
    kb_note [shape=note, style=filled, fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=10,
          label="fixed 2026-09-22: the keyboard listener crashed\n(termios.error) if stdin wasn't a real terminal,\ndying silently since it's a daemon thread. Guarded\nwith sys.stdin.isatty() first. That still leaves\nraw stdin serving only one process at a time, so\nfsm_command (/fsm_command, above) gives a second\ninput path that works no matter who owns stdin.\nVerified against the real class; not yet live."];
    kb_note -> state [style=dotted, color="#16A34A", arrowhead=none];
    ds_note [shape=note, style=filled, fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=10,
          label="fixed 2026-09-22: drive_square.py ran its square\nonce, immediately at startup, regardless of\nfsm_node.py's state -- unreachable through the\ngateway unless already in DRIVE SQUARE by the\ntime that run finished. Now subscribes to\ncurrent_mode and restarts on freshly entering\nDRIVE SQUARE. Verified against the real class;\nnot yet live. Standalone use is unaffected."];
    ds_note -> ds [style=dotted, color="#16A34A", arrowhead=none];
    { rank=same; note; robot; }
}
