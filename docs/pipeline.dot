// Mapping -> planning -> following pipeline.  Render: dot -Tpng -Gdpi=200 pipeline.dot -o figures/pipeline.png
digraph Pipeline {
    graph [rankdir=LR, fontname="DejaVu Sans", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.8, splines=spline];
    node  [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", penwidth=1.6, margin="0.2,0.13"];
    edge  [fontname="DejaVu Sans", fontsize=10.5, color="#4B5563", fontcolor="#1F2937", penwidth=1.4];

    user  [label="Person", shape=oval, fillcolor="#FEF3C7", color="#D97706"];
    tele  [label="teleop_scan.py\nkeyboard driving", fillcolor="#DBEAFE", color="#2563EB"];
    room  [label="room_map.py\nlog-odds occupancy grid", fillcolor="#DBEAFE", color="#2563EB"];
    map   [label="saved map\nroom_map.yaml + .pgm", shape=cylinder, fillcolor="#F3F4F6", color="#6B7280"];
    path  [label="path_following.py\nGUI + pure pursuit", fillcolor="#EDE9FE", color="#7C3AED"];
    astar [label="a_star.py\ninflate obstacles, plan", fillcolor="#EDE9FE", color="#7C3AED"];
    robot [label="Neato", shape=oval, fillcolor="#DCFCE7", color="#16A34A"];
    fsm   [label="fsm_node.py", fillcolor="#FEE2E2", color="#DC2626"];

    user  -> tele  [label="drives"];
    tele  -> room  [label="/scan + /odom"];
    room  -> map   [label="press m"];
    map   -> path  [label="loaded"];
    user  -> path  [label="draw route or\nclick goal", constraint=false];
    path  -> astar [label="goal", dir=both];
    path  -> fsm   [label="cmd_vel_path_following"];
    fsm   -> robot [label="cmd_vel"];
    fsm   -> path  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#1F2937" POINT-SIZE="10.5">current_mode (show/hide GUI)</FONT></TD></TR></TABLE>>, style=dashed, headport=w];
}
