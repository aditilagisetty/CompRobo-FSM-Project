// Finite state machine of finite_state_controller.py.  Render: dot -Tpng -Gdpi=200 fsm.dot -o figures/fsm.png
digraph FSM {
    graph [rankdir=LR, compound=true, fontname="DejaVu Sans", bgcolor="white",
           pad=0.3, nodesep=0.55, ranksep=0.9, splines=spline];
    node  [fontname="DejaVu Sans Bold", fontsize=13, shape=box, style="rounded,filled",
           penwidth=1.6, margin="0.22,0.14"];
    edge  [fontname="DejaVu Sans", fontsize=10.5, color="#4B5563", fontcolor="#1F2937",
           penwidth=1.4, arrowsize=0.9];

    start [shape=circle, label="", width=0.22, style=filled, fillcolor="#111827", color="#111827"];

    subgraph cluster_local {
        label="handled inside finite_state_controller.py"; labeljust=l;
        fontsize=11; fontcolor="#6B7280"; style="rounded,dashed"; color="#9CA3AF"; margin=14;
        DRIVE  [label="DRIVE_SQUARE\ndefault state",  fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A"];
        COLL   [label="COLLISION_AVOIDANCE\nback up and turn away", fillcolor="#FEE2E2", color="#DC2626", fontcolor="#7F1D1D"];
        WALL   [label="WALL_FOLLOWING\nP-control on side distance", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
    }

    PATH [label="PATH_FOLLOWING\npath_following.py is driving;\nFSM publishes nothing",
          fillcolor="#EDE9FE", color="#7C3AED", fontcolor="#4C1D95"];

    start -> DRIVE;
    DRIVE -> COLL  [label="bump, or something\nunder 0.3 m ahead", color="#DC2626", fontcolor="#991B1B"];
    COLL  -> DRIVE [label="clear", style=dashed, color="#DC2626", fontcolor="#991B1B"];
    DRIVE -> WALL  [label="wall under 0.75 m\nat +/-90 deg", color="#16A34A", fontcolor="#166534"];
    WALL  -> DRIVE [label="no wall detected", style=dashed, color="#16A34A", fontcolor="#166534"];

    COLL -> PATH [ltail=cluster_local, label="path_following_status is\n'following' or 'paused'\n(checked first, from any state)",
                  color="#7C3AED", fontcolor="#5B21B6", penwidth=2.2, constraint=true];
    PATH:s -> DRIVE:s [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#5B21B6" POINT-SIZE="10.5">status is 'idle' or 'done'</FONT></TD></TR></TABLE>>, style=dashed,
                  color="#7C3AED", constraint=false, labelfloat=false];
}
